# Meme'd Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection URI
# Options:
# 1. MongoDB Atlas URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/memed?retryWrites=true&w=majority
# 2. Local MongoDB: mongodb://localhost:27017/memed
# 3. Built-in In-Memory DB (Zero setup!): leave blank or set to 'memory'
MONGODB_URI=memory

# JWT Secret Key
JWT_SECRET=memed_super_secret_jwt_key_change_in_production_2025

# Optional: Redis URL for caching campaign listings
# (If omitted, system gracefully falls back to direct database queries)
# REDIS_URL=redis://localhost:6379

